-- project/calc_test.go --
package calc

import "testing"

func TestCalc(t *testing.T) {
	if Add(2, 3) != 5 {
		t.Fatal("Add")
	}
	if Sub(5, 3) != 2 {
		t.Fatal("Sub")
	}
	if Mul(4, 3) != 12 {
		t.Fatal("Mul")
	}
	if q, ok := Div(12, 4); q != 3 || !ok {
		t.Fatal("Div")
	}
	if _, ok := Div(1, 0); ok {
		t.Fatal("Div by zero")
	}
}
