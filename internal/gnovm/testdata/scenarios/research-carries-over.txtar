-- project/go.mod --
module shapes

go 1.22
-- project/a.go --
package shapes

func Square(x int) int { return x * x }

func Cube(x int) int { return x * x * x }

func Twice(x int) int { return 2 * x }
-- project/b.go --
package shapes

func Add(a, b int) int { return a + b }

func Sub(a, b int) int { return a - b }

func Neg(a int) int { return -a }

func Abs(a int) int {
	if a < 0 {
		return -a
	}
	return a
}

func Sign(a int) int {
	switch {
	case a < 0:
		return -1
	case a > 0:
		return 1
	}
	return 0
}
-- project/c.go --
package shapes

type Point struct{ X, Y int }

func (p Point) Norm1() int { return Abs(p.X) + Abs(p.Y) }

func Origin() Point { return Point{} }
