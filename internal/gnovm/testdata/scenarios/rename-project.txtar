-- project/go.mod --
module klash

go 1.22
-- project/main.go --
// Command klash greets whoever runs it.
package main

import (
	"fmt"
	"os"
)

const name = "klash"

func usage() string {
	return "usage: " + name + " [--who NAME]"
}

func greeting(who string) string {
	return name + " says hello, " + who
}

func main() {
	who := "world"
	switch {
	case len(os.Args) == 3 && os.Args[1] == "--who":
		who = os.Args[2]
	case len(os.Args) > 1:
		fmt.Fprintln(os.Stderr, usage())
		os.Exit(2)
	}
	fmt.Println(greeting(who))
}
-- project/main_test.go --
package main

import (
	"strings"
	"testing"
)

func TestUsageNamesTheProgram(t *testing.T) {
	if !strings.HasPrefix(usage(), "usage: klash") {
		t.Fatalf("usage = %q", usage())
	}
}

func TestGreeting(t *testing.T) {
	if got := greeting("Lin"); got != "klash says hello, Lin" {
		t.Fatalf("greeting = %q", got)
	}
}
-- project/README.md --
# klash

klash greets whoever runs it.

    go build -o klash .
    ./klash --who Lin

klash reads its settings from `klash.toml`; `klash.example.toml` shows them.
